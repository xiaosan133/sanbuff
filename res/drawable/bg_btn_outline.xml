<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮：描边胶囊。disabled（列表里的"已安装"）靠 selector 换描边色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/vdesk_transparent" />
            <stroke android:width="1dp" android:color="@color/vdesk_text_faint" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/vdesk_ripple">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/vdesk_transparent" />
                    <stroke android:width="1dp" android:color="@color/vdesk_accent" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
