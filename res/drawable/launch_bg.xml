<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 深色背景铺满窗口 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vdesk_launch_bg" />
        </shape>
    </item>
    <!-- 旋转弧居中固定尺寸，避免被拉伸 -->
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center">
        <animated-vector
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:drawable="@drawable/launch_ring">
            <target
                android:name="ring_group"
                android:animation="@animator/launch_rotate" />
        </animated-vector>
    </item>
</layer-list>
