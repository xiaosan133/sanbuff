<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面网格里的一个应用：图标 + 一行名字。整格按压有波纹（bg_tile）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="@dimen/sp_2"
    android:paddingBottom="@dimen/sp_1"
    android:background="@drawable/bg_tile">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/icon_app"
        android:layout_height="@dimen/icon_app"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:paddingLeft="@dimen/sp_1"
        android:paddingRight="@dimen/sp_1"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/vdesk_text"
        android:textSize="12sp" />
</LinearLayout>
